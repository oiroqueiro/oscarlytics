FROM docker.io/library/nginx:alpine

COPY nginx.conf /etc/nginx/nginx.conf
# Certs are now dynamic and managed via portfolio_certs volume

# We will expose 8081 and 8443
EXPOSE 8081 8443

# Auto-reload certs every 12 hours gracefully
CMD ["/bin/sh", "-c", "while true; do sleep 43200; nginx -s reload 2>/dev/null || true; done & exec nginx -g 'daemon off;'"]
